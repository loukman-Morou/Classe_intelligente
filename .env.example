# ============================================================
# Phases 0-6 — variables actives (requises pour démarrer)
# ============================================================
NODE_ENV=development
PORT=3000

CORS_ALLOWED_ORIGINS=http://localhost:3001

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOG_LEVEL=info

# Phase 1 — PostgreSQL
DATABASE_URL=postgresql://classe_intelligente:dev_only_change_me@localhost:5432/classe_intelligente?schema=public

# Phase 2 — JWT (deux secrets DISTINCTS, >= 32 caractères chacun)
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_chars_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_with_at_least_32_random_chars_refresh
JWT_REFRESH_TTL=30d
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# Phase 6 — Stockage privé compatible S3 (Cloudflare R2, MinIO, AWS S3...)
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=classe-intelligente
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Phase 6 — Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Administration — résilience (min 2, défaut 3)
MAX_ADMINS=3

# Limites upload (modifiables sans redéploiement)
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_MAX_QUOTA_PER_COURSE_BYTES=524288000

# ============================================================
# Phases suivantes — NON utilisées actuellement.
# ============================================================
# Phase 8/9 — IA
# OPENAI_API_KEY=
# LLM_MODEL=

# Phase 8 — Embeddings et RAG (décommenter et remplir)
OPENAI_API_KEY=sk-replace_me
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.70
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1000

# Phase 13 — Cycle de vie des classes (durées configurables)
LIFECYCLE_INACTIVE_AFTER_DAYS=90
LIFECYCLE_ARCHIVE_AFTER_DAYS=180
LIFECYCLE_PENDING_DELETION_AFTER_DAYS=365
LIFECYCLE_DELETED_AFTER_DAYS=30
LIFECYCLE_CRON=0 2 * * *
